---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Page Not Found — WordTally"
	description="The page you're looking for doesn't exist. Return to WordTally, the free live word and character counter."
	canonicalPath="/404"
>
	<section class="mx-auto max-w-xl text-center">
		<p class="font-display text-6xl font-bold text-[#C9982E]">404</p>
		<h1 class="mt-4 text-3xl font-bold tracking-tight text-[#2B2013] sm:text-4xl">
			Page not found
		</h1>
		<p class="mt-4 text-base leading-relaxed text-[#5C4F3D]">
			The page you're looking for doesn't exist or may have moved.
		</p>
		<a
			href={import.meta.env.BASE_URL.replace(/\/+$/, '') + '/'}
			class="mt-8 inline-block rounded-lg bg-[#C9982E] px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-[#B8860B]"
		>
			Back to WordTally
		</a>
	</section>
</Layout>
