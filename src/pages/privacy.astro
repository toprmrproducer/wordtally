---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Privacy Policy — WordTally"
	description="WordTally's privacy policy: what data we collect (none of your text), how the tool works client-side, and how advertising and analytics may be used."
	canonicalPath="/privacy"
>
	<section class="mx-auto max-w-2xl">
		<h1 class="text-4xl font-extrabold tracking-tight text-[#221b10] sm:text-5xl">
			Privacy Policy
		</h1>
		<p class="mt-4 text-[15px] text-[#8a7e68]">Last updated: 2026</p>

		<div class="mt-8 space-y-6 text-lg leading-relaxed text-[#4a4234]">
			<div>
				<h2 class="text-xl font-bold text-[#221b10]">Your text stays on your device</h2>
				<p class="mt-2">
					WordTally performs all word, character, sentence, readability, and
					keyword counting directly in your browser using JavaScript. The
					text you type or paste into the tool is never transmitted to our
					servers, never stored, and never seen by us. Closing or refreshing
					the tab clears it completely.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-bold text-[#221b10]">Analytics</h2>
				<p class="mt-2">
					We may use privacy-respecting analytics to understand aggregate
					traffic (e.g. page views, general location, device type) so we can
					improve the site. This data is not tied to the content you type
					into the counter.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-bold text-[#221b10]">Advertising</h2>
				<p class="mt-2">
					This site may display advertisements served by third-party ad
					networks, such as Google AdSense. These networks may use cookies or
					similar technologies to serve relevant ads based on your visit to
					this and other websites. You can opt out of personalized
					advertising through your ad network's settings or through your
					browser's cookie controls.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-bold text-[#221b10]">Cookies</h2>
				<p class="mt-2">
					We do not use cookies to store or identify the text you enter.
					Cookies set by advertising or analytics providers are governed by
					their own privacy policies.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-bold text-[#221b10]">Changes to this policy</h2>
				<p class="mt-2">
					We may update this policy from time to time. Continued use of
					WordTally after changes are posted constitutes acceptance of the
					updated policy.
				</p>
			</div>

			<div>
				<h2 class="text-xl font-bold text-[#221b10]">Contact</h2>
				<p class="mt-2">
					If you have questions about this privacy policy, please reach out
					through the contact details listed on our About page.
				</p>
			</div>
		</div>
	</section>
</Layout>
